<IfModule mod_rewrite.c>
    RewriteEngine On

    # Lindungi file konfigurasi dan folder Git
    RewriteRule ^(?:\.env|\.git(?:/|$)) - [F,L,NC]

    # Jangan rewrite ulang path yang sudah berada di folder public⏎
    RewriteRule ^public(?:/|$) - [L]

    # Arahkan seluruh request subdomain ke folder public Laravel⏎
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>